{
  "schema": "../../node_modules/nx/schemas/project-schema.json",
  "targets": {
    "echo": {
      "command": "sleep 1; node {projectRoot}/lib/index.js"
    },
    "watch": {
      "dependsOn": ["echo"],
      "command": "nx watch --projects {projectName} -- echo \\$NX_PROJECT_NAME \\$NX_FILE_CHANGES",
      "continuous": true
    }
  }
}
